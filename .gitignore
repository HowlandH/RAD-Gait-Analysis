# Gait Tracker - Git Ignore File

# ============================================
# Operating System Files
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Arduino IDE Files
# ============================================

# Build outputs
*.hex
*.eep
*.elf
*.bin
*.map
*.lss
*.sym

# Arduino build directory
build/
*.build/

# Arduino libraries (if using library manager, these are downloaded)
# Uncomment if you want to track custom libraries:
# !libraries/

# Arduino preferences and cache
.arduino15/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ============================================
# Xcode / iOS Development
# ============================================

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved
*.xcodeproj

# CocoaPods
Pods/
*.podspec
Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/README.md

# App packaging
*.ipa
*.dSYM.zip
*.dSYM
*.app

# Provisioning profiles
*.mobileprovision
*.provisionprofile

