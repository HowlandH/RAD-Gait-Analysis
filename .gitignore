# ============================================

# Inventor backup files
OldVersions/
*.iam~
*.ipt~
*.idw~
*.dwg~
*.bak

# Inventor lock files
*.lck

# Inventor project files (optional - uncomment if you don't want to track)
# *.ipj

# ============================================
# IDE / Editor Files
# ============================================

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs (CLion, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*.swn
.*.sw?

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# ============================================
# Build and Dependency Directories
# ============================================

# Node modules (if using any web tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments (if using any Python tools)
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================
# Documentation and Reports
# ============================================

# Generated documentation
docs/_build/
docs/.doctrees/
site/

# Test reports
*.log
test_results/
coverage/

# ============================================
# Data and Media Files
# ============================================

# Large binary files
*.bin
*.dat
*.sqlite
*.db

# Video files (test recordings)
*.mp4
*.mov
*.avi
*.mkv

# Large image files (keep smaller reference images)
# Uncomment if you want to ignore all images:
# *.jpg
# *.jpeg
# *.png

# CSV data exports (test run data - can be large)
test_data/*.csv
field_test_data/*.csv

# ============================================
# Temporary and Cache Files
# ============================================

# General temporary files
*.tmp
*.temp
*.cache
*.bak
*.backup
*.old

# Thumbnails
._*
.thumbnails/

# Archives (unless specifically needed for releases)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# Security and Credentials
# ============================================

# API keys and credentials
.env
.env.local
.env.*.local
credentials.json
secrets.json
*.pem
*.key
*.cert

# SSH keys
id_rsa
id_rsa.pub
*.ppk

# ============================================
# Project-Specific
# ============================================

# Compiled firmware binaries (except releases)
firmware_builds/
*.firmware

# Field test data (can be large)
field_tests/data/*.csv
field_tests/videos/*.mp4

# Calibration data (generated at runtime)
calibration_data/
*.cal

# User-specific settings
user_settings.json
local_config.h

# ============================================
# Version Control
# ============================================

# Git conflict files
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

# ============================================
# Keep These Files
# ============================================

# Force include important files even if they match patterns above
!.gitignore
!.gitattributes
!README.md
!LICENSE
!CLAUDE.md

# Keep example/template configuration files
!config.example.h
!settings.template.json

# Keep small reference images in docs
!docs/images/*.png
!docs/images/*.jpg

# Keep 3D print STL files (these are deliverables)
!enclosure/*.stl
!enclosure/*.iam
!enclosure/*.ipt

# Scratch
Scratch/